{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "templates",
    "recipes",
    ".agents",
    ".cursor",
    ".sandbox",
    ".temp",
    "coverage",
    "tests/fixtures",
    "pnpm-lock.yaml"
  ]
}
