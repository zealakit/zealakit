{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zealakit.json for a stack workspace (schemaVersion 2)",
  "type": "object",
  "required": ["schemaVersion", "kitVersion", "createdAt", "stack", "root"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "kitVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "stack": {
      "type": "object"
    },
    "root": {
      "type": "object",
      "required": ["recipes"],
      "properties": {
        "recipes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
