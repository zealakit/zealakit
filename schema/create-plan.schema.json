{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zealakit create --dry-run --json",
  "type": "object",
  "required": ["ok", "config", "targetDir", "files", "packages", "checks", "blockers", "warnings"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "config": {
      "type": "object",
      "required": ["projectName", "templateId", "recipeIds"]
    },
    "targetDir": {
      "type": "string"
    },
    "files": {
      "type": "array"
    },
    "packages": {
      "type": "object"
    },
    "checks": {
      "type": "array"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
