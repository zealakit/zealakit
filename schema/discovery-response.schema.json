{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discovery JSON API response",
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "ok", "operation", "data"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "operation": {
          "enum": ["questions", "recommendations", "validate", "scaffold"]
        },
        "data": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "required": ["schemaVersion", "ok", "operation", "error"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "operation": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": ["code", "message", "details"],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
