{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "dist",
    "build",
    ".next",
    ".nuxt",
    ".output",
    ".svelte-kit",
    ".astro",
    "storybook-static",
    "coverage",
    "node_modules",
    ".agents",
    "zealakit.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lockb"
  ],
  "sortPackageJson": false
}
