{
  "name": "zealakit",
  "version": "1.0.0-beta.1",
  "description": "Recipe-based scaffolding CLI for TypeScript project templates",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "zealakit": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "recipes",
    "!recipes/tsconfig.json",
    "!recipes/shims.d.ts",
    "!templates/**/dist",
    "!templates/**/.next",
    "!templates/**/node_modules",
    "!templates/**/coverage",
    "!templates/**/*.tsbuildinfo",
    "!templates/**/pnpm-lock.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p monitor/tsconfig.json",
    "test": "tsx scripts/test.ts",
    "test:unit": "tsx scripts/test.ts --unit",
    "test:scaffold": "tsx scripts/test.ts --scaffold",
    "test:pack": "tsx scripts/test-e2e-pack.ts",
    "monitor": "tsx monitor/server.ts",
    "prepack": "tsx scripts/pack-dotfiles.ts add",
    "postpack": "tsx scripts/pack-dotfiles.ts remove",
    "prepublishOnly": "pnpm build",
    "release": "tsx scripts/publish.ts",
    "test:sandbox": "rm -rf .sandbox/*/ && mkdir -p .sandbox && cd .sandbox && tsx ../src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.14.0",
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "vite",
    "react",
    "next",
    "nestjs",
    "hono"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/zealakit.git"
  },
  "bugs": {
    "url": "https://github.com/zealakit/zealakit/issues"
  },
  "homepage": "https://github.com/zealakit/zealakit#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
