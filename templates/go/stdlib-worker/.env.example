# Documentation only — this app does not auto-load .env files.
# Export variables in your shell, or use a process manager.

APP_NAME=stdlib-worker
APP_ENV=development

LOG_LEVEL=info
LOG_FORMAT=text

# How often the worker runs one processing tick.
WORKER_INTERVAL=30s

# Max time to wait for an in-flight tick after SIGINT/SIGTERM.
WORKER_SHUTDOWN_TIMEOUT=10s
