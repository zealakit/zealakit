---
import { render } from "astro:content";
import type { Locale } from "@/i18n/config";
import type { Article } from "@/lib/articles/types";
import SiteLayout from "@/layouts/site-layout/index.astro";

type Props = {
  locale: Locale;
  article: Article;
};

const { locale, article } = Astro.props;
const { title, description, pubDate, updatedDate, author, image } = article;

const rendered =
  article.source === "content" ? await render(article.entry) : null;
const Content = rendered?.Content;

const siteOrigin = Astro.site ?? new URL("https://example.com");
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const imageURL = image ? new URL(image, siteOrigin) : undefined;
const publishedTime = new Date(pubDate).toISOString();
const modifiedTime = new Date(updatedDate ?? pubDate).toISOString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    "@type": "Person",
    name: author,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
  inLanguage: locale,
  ...(imageURL ? { image: [imageURL.href] } : {}),
};
---

<SiteLayout
  locale={locale}
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  imageURL={imageURL}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  jsonLd={jsonLd}
>
  <article>
    <header>
      <h1>{title}</h1>
      <p>{description}</p>
      <p>
        <time datetime={publishedTime}>{new Date(pubDate).toLocaleDateString(locale)}</time>
        {" · "}
        {author}
      </p>
    </header>
    {article.source === "cms" ? (
      <div class="article-body" set:html={article.bodyHtml} />
    ) : Content ? (
      <div class="article-body">
        <Content />
      </div>
    ) : null}
  </article>
</SiteLayout>
